# Copy to .env.local and fill in. Restart the dev server after changing.
# Vite only exposes vars prefixed with VITE_ to the browser.

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Comma-separated emails allowed into /admin (client-side hint; the real gate
# is the `admins` table + RLS in the database). Optional.
VITE_ADMIN_EMAILS=kevininfant12@gmail.com
